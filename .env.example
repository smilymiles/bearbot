# Copy this file to ".env" and fill in your values. Never commit your real .env!

# Required: your Discord bot token
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server (guild) ID — makes slash commands update INSTANTLY in that server.
# Enable Developer Mode (User Settings > Advanced), right-click your server, "Copy Server ID".
# Leave blank to sync globally (can take up to 1 hour to appear).
GUILD_ID=

# Optional: public URL for the keep-alive self-ping.
# On Render this is provided automatically as RENDER_EXTERNAL_URL — no need to set this.
# KEEPALIVE_URL=
